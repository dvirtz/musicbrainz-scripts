export default "._dialog__panel_15w8e_1 {\r\n  position: fixed;\r\n  z-index: 10000;\r\n  top: 50%;\r\n  left: 50%;\r\n}\r\n\r\n._dialog__overlay_15w8e_15 {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 50;\r\n  background-color: rgb(0 0 0 / 0.2);\r\n  animation: _overlayHide_15w8e_1 250ms ease 100ms forwards;\r\n}\r\n\r\n._dialog__overlay_15w8e_15[data-expanded] {\r\n  animation: _overlayShow_15w8e_1 250ms ease;\r\n}\r\n\r\n._dialog__positioner_15w8e_39 {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 50;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n._dialog__content_15w8e_57 {\r\n  z-index: 50;\r\n  max-width: min(calc(100vw - 16px), 500px);\r\n  border: 1px solid hsl(240 5% 84%);\r\n  border-radius: 6px;\r\n  padding: 16px;\r\n  background-color: white;\r\n  box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\r\n  animation: _contentHide_15w8e_1 300ms ease-in forwards;\r\n}\r\n\r\n._dialog__content_15w8e_57[data-expanded] {\r\n  animation: _contentShow_15w8e_1 300ms ease-out;\r\n}\r\n\r\n._dialog__header_15w8e_87 {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: space-between;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n._dialog__close_button_15w8e_101 {\r\n  appearance: none;\r\n  display: inline-flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  height: 40px;\r\n  width: auto;\r\n  outline: none;\r\n  border-radius: 6px;\r\n  padding: 0 16px;\r\n  background-color: hsl(200 98% 39%);\r\n  color: white;\r\n  font-size: 16px;\r\n  line-height: 0;\r\n  transition: 250ms background-color;\r\n}\r\n\r\n._dialog__close_button_15w8e_101:hover {\r\n  background-color: hsl(201 96% 32%);\r\n}\r\n\r\n._dialog__close_button_15w8e_101:focus-visible {\r\n  outline: 2px solid hsl(200 98% 39%);\r\n  outline-offset: 2px;\r\n}\r\n\r\n._dialog__close_button_15w8e_101:active {\r\n  background-color: hsl(201 90% 27%);\r\n}\r\n\r\n._dialog__close_buttons_15w8e_161 {\r\n  margin: 8px;\r\n  display: flex;\r\n  gap: 8px;\r\n  justify-content: flex-end;\r\n}\r\n\r\n._dialog__title_15w8e_175 {\r\n  font-size: 20px;\r\n  font-weight: 500;\r\n  color: hsl(240 6% 10%);\r\n  margin: 0;\r\n}\r\n\r\n._dialog__description_15w8e_189 {\r\n  font-size: 16px;\r\n  color: hsl(240 5% 26%);\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n._checkbox_15w8e_203 {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  margin: 10px;\r\n}\r\n\r\n._checkbox__control_15w8e_215 {\r\n  height: 20px;\r\n  width: 20px;\r\n  border-radius: 6px;\r\n  border: 1px solid hsl(240 5% 84%);\r\n  background-color: hsl(240 6% 90%);\r\n}\r\n\r\n._checkbox__input_15w8e_231:focus-visible+._checkbox__control_15w8e_215 {\r\n  outline: 2px solid hsl(200 98% 39%);\r\n  outline-offset: 2px;\r\n}\r\n\r\n._checkbox__control_15w8e_215[data-checked] {\r\n  border-color: hsl(200 98% 39%);\r\n  background-color: hsl(200 98% 39%);\r\n  color: white;\r\n}\r\n\r\n._checkbox__label_15w8e_253 {\r\n  margin-left: 6px;\r\n  color: hsl(240 6% 10%);\r\n  font-size: 14px;\r\n  user-select: none;\r\n}\r\n\r\n@keyframes _overlayShow_15w8e_1 {\r\n  from {\r\n    opacity: 0;\r\n  }\r\n\r\n  to {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@keyframes _overlayHide_15w8e_1 {\r\n  from {\r\n    opacity: 1;\r\n  }\r\n\r\n  to {\r\n    opacity: 0;\r\n  }\r\n}\r\n\r\n@keyframes _contentShow_15w8e_1 {\r\n  from {\r\n    opacity: 0;\r\n    transform: scale(0.96);\r\n  }\r\n\r\n  to {\r\n    opacity: 1;\r\n    transform: scale(1);\r\n  }\r\n}\r\n\r\n@keyframes _contentHide_15w8e_1 {\r\n  from {\r\n    opacity: 1;\r\n    transform: scale(1);\r\n  }\r\n\r\n  to {\r\n    opacity: 0;\r\n    transform: scale(0.96);\r\n  }\r\n}\r\n"